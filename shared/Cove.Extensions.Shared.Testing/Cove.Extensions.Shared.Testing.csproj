<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Test-support only: never a deployed Cove plugin, so neutralize the inherited dynamic-loading flag. -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <!--
      This project is consumed by the two *.Tests projects (via ProjectReference) and its FakeStore /
      ConcurrentFakeStore implement IExtensionStore from Cove.Plugins. It is a NON-.Tests project, so the
      root Directory.Build.targets wires Cove.Sdk into it (transitively carrying Cove.Plugins) — a
      ProjectReference on the local-cove path, a Cove.Sdk PackageReference on the bare (NuGet) path. On
      BOTH paths the Cove.Sdk strip target runs (imported explicitly on the local path, transitively from
      the package on the NuGet path) and would strip Cove.Plugins.dll from THIS project's output. Empty the
      host-provided denylist so nothing is stripped: the value must be NON-EMPTY (Cove.Sdk.targets re-applies
      its full default denylist when the property is empty), so a sentinel matching no real assembly name
      disables the strip without re-triggering the default.
    -->
    <CoveHostProvidedAssemblies>;__cove_extensions_shared_testing_no_strip__;</CoveHostProvidedAssemblies>
    <!--
      The inherited test-project flag arrives from the xunit package reference below, not from anything
      this repo sets, so VSTest treats this assembly as a test container and a solution-level
      `dotnet test` launches a testhost for it. There is nothing for that host to run: the only [Fact]-bearing class here is
      abstract and executes solely through Renamer.Tests' derivation of it. The launch does not merely
      waste time — it aborts the whole run when the testhost cannot resolve, taking the real suite with
      it. See the ItemGroup below for why xunit is referenced here at all.
    -->
    <IsTestProject>false</IsTestProject>
    <!--
      CA1716 flags the "Shared" namespace segment as a VB reserved keyword (a cross-language-interop
      concern). This is a C#-only test-support assembly consumed solely by the *.Tests projects, never
      from VB, so the rule does not apply; scoped here (not root config) to keep the chosen namespace name.
      Mirrors the same suppression on Cove.Extensions.Shared.csproj.
    -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      TEST-SUPPORT ONLY (IsPackable=false — none of this reaches a deployed plugin).
      ExtensionOpenApiDocumentTests boots a WebApplication over TestHost and pulls the generated
      document from IOpenApiDocumentProvider, so the OpenAPI integration and the in-memory server both
      have to be referenceable from HERE rather than from each consuming test project: the emit is the
      one place the StartAsync ordering can be got wrong, and a per-extension copy of it is a
      per-extension chance to omit that call. xunit arrives with them because the emit carries its own
      [Fact] for the same reason. Renamer.Tests keeps its OWN TestHost reference: TransportSmokeTests
      uses UseTestServer/GetTestClient directly and does not go through this project.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- The writer and info types the emit serializes through, and the patched floor the ASP.NET Core
         integration's own transitive resolve falls below (see Directory.Packages.props). -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="xunit" />
  </ItemGroup>
</Project>
