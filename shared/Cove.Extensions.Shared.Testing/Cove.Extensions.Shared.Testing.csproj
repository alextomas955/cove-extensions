<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Test-support only: never a deployed Cove plugin, so neutralize the inherited dynamic-loading flag. -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <!--
      Test support, consumed by the *.Tests projects, whose FakeStore / ConcurrentFakeStore implement
      IExtensionStore from Cove.Plugins. The name does not end in .Tests, so the root
      Directory.Build.targets wires Cove.Sdk in and its strip runs on both the local-source and the
      package path, taking Cove.Plugins.dll out of this project's output. Directory.Build.targets
      turns this into what Cove.Sdk reads.
    -->
    <CoveStripHostProvidedAssemblies>false</CoveStripHostProvidedAssemblies>
    <!--
      CA1716 flags the "Shared" namespace segment as a VB reserved keyword (a cross-language-interop
      concern). This is a C#-only test-support assembly consumed solely by the *.Tests projects, never
      from VB, so the rule does not apply; scoped here (not root config) to keep the chosen namespace name.
      Mirrors the same suppression on Cove.Extensions.Shared.csproj.
    -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!--
      The OpenAPI emit lives HERE rather than in each consuming test project because the StartAsync
      ordering is the one thing it can get wrong, and a per-extension copy is a per-extension chance to
      omit that call.
    -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Pinned above the floor the ASP.NET Core integration's own transitive resolve falls to
         (see Directory.Packages.props). -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <!--
      The runner-free half of xUnit v3: attributes from extensibility.core, Assert from the assert
      package. The xunit.v3 metapackage would drag in the Microsoft Testing Platform runner, which
      refuses to build anything but an executable.
    -->
    <PackageReference Include="xunit.analyzers" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>
</Project>
