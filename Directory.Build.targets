<Project>

  <!--
    Sonar's C# rules, on every project including the test ones, and unconditional on how Cove is
    located: the analyzer inspects this repo's own source and has nothing to do with the host.

    Note what adoption does to the pre-commit hook, because nothing else says it: that hook runs
    per-file, so from here on it is also a per-file Sonar gate - clean on a file you did not touch
    while findings may stand elsewhere.
    The CI legs do not all build the same way: the analyzer gate in lint.yml builds the solution in source mode
    against a checked-out Cove, so it sees what a local source build sees, while the packaging and Windows
    legs build in none mode over the projects that need no checkout.
  -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" />
  </ItemGroup>


  <!--
    Cove.Sdk + Cove.Core wiring, centralized here so individual extension .csproj files under
    extensions/<Name>/src/<Name>/ don't each restate the local-vs-package selection or the
    relative-path math back to the sibling ../cove checkout. Cove.Sdk transitively carries
    Cove.Plugins and Cove.Core (Cove.Sdk -> Cove.Plugins -> Cove.Core), so referencing Cove.Sdk
    alone is sufficient — extension projects should NOT add a direct Cove.Plugins reference.

    Cove.Data is intentionally NOT wired here: it sits outside the Cove.Sdk/Cove.Plugins/Cove.Core
    chain and is consumed test-only (Cove.Extensions.Shared.Testing.Cove's CoveContextFactory). A
    project that needs it names $(CoveDataProjectPath) itself.

    Scoped to non-test projects only (MSBuildProjectName not ending in ".Tests"): a *.Tests project
    already receives Cove.Sdk/Cove.Plugins/Cove.Core transitively through its ProjectReference to the
    extension project this wiring targets. Applying this ItemGroup unconditionally to *.Tests projects
    too would add Cove.Sdk as a SECOND, directly-referenced Private=false dependency on the same test
    project — which (unlike the single-hop transitive reference) MSBuild resolves as non-copy-local,
    so Cove.Sdk.dll silently drops out of the test project's own bin/ output and xUnit fails at
    reflection time with "Could not load file or assembly 'Cove.Sdk'". Excluding *.Tests here keeps
    each test project's only path to Cove.Sdk the transitive one through its extension ProjectReference,
    matching the single-extension-repo template's original per-project (not root-centralized) wiring.
  -->

  <ItemGroup Condition="'$(CoveSourceMode)' == 'source' AND !$(MSBuildProjectName.EndsWith('.Tests'))">
    <ProjectReference Include="$(CoveSdkProjectPath)" Condition="Exists('$(CoveSdkProjectPath)')">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(CoveSourceMode)' != 'source' AND !$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Cove.Sdk" />
  </ItemGroup>

  <!--
    Local-source build only: the Cove.Sdk host-assembly stripping rules ship in the NuGet package's
    buildTransitive/ folder, so they are auto-imported on the PackageReference (publish) path but NOT
    when Cove.Sdk is consumed as a local ProjectReference. Import them explicitly so the local-source
    publish set is stripped identically to the NuGet path — otherwise the transitive Cove.Core.dll
    (and friends) leaks into the published output. Excluded for *.Tests projects (see above): a test
    project is never published/deployed, so it must keep its full runtime closure and never import
    the host-provided-assembly strip target at all.
  -->
  <Import Project="$(CoveSdkTargetsPath)"
          Condition="'$(CoveSourceMode)' == 'source' AND !$(MSBuildProjectName.EndsWith('.Tests')) AND Exists('$(CoveSdkTargetsPath)')" />

  <!--
    The gate on the Cove location. Directory.Build.props can only COMPUTE the mode; stopping a build
    needs a target, and this one runs BeforeTargets="PrepareForBuild" so it lands ahead of the
    compiler and a wrong location reports as one plain error rather than as a wall of CS0234.

    Printing the resolved ABSOLUTE path is part of the design rather than a courtesy: it is what makes
    Git Bash's MSYS rewriting of a POSIX COVE_REPO into a drive-lettered path visible, and that class
    of silent path mangling has disabled gates in this repo before.

    Absence stays a legitimate state: none is the clean-clone default, and the solution build succeeds
    under it by skipping the project that declares a Cove checkout as required. What is refused is a
    mode that cannot deliver what it names - a mode pinned to source with no checkout behind it, or a
    location supplied explicitly that resolved to none.
  -->
  <Target Name="AssertCoveLocation" BeforeTargets="PrepareForBuild">
    <Message Importance="high" Text="Cove: mode=$(CoveSourceMode) repoRoot='$(CoveRepoRootResolved)'" />

    <Error Condition="'$(CoveSourceMode)' != 'source' AND '$(CoveSourceMode)' != 'none'"
           Text="CoveSourceMode is '$(CoveSourceMode)', which is not one of source or none. Set -p:CoveSourceMode (or COVE_SOURCE_MODE) to one of those two; an unrecognised mode wires up neither references nor exclusions and would fail far from its cause." />

    <Error Condition="'$(CoveSourceMode)' == 'source' AND !Exists('$(CoveDataProjectPath)')"
           Text="Cove source mode was selected but Cove.Data.csproj is not at '$(CoveDataProjectPath)' (resolved CoveRepoRoot='$(CoveRepoRootResolved)'). Point COVE_REPO or -p:CoveRepoRoot at a Cove checkout, or select mode none. Refusing to fall back, because the fallback would skip the project this mode was chosen to build." />

    <!-- The belt on the precedence in Directory.Build.props: no arm there can reach `none` while a
         location was supplied explicitly, so this cannot fire today. It is here so that a future edit
         reintroducing the fall-through is a build error rather than a quietly smaller run. A caller who
         pinned the mode (or the older UseLocalCoveSource spelling) said `none` on purpose. -->
    <Error Condition="'$(CoveSourceMode)' == 'none' AND '$(_CoveLocationWasExplicit)' == 'true' AND '$(_CoveModeWasPinned)' != 'true'"
           Text="A Cove location was supplied explicitly (resolved CoveRepoRoot='$(CoveRepoRootResolved)') but the resolved mode is 'none'. Refusing to fall back to the cove-absent branch, because a location was supplied on purpose and the fallback would not use it." />
  </Target>

  <PropertyGroup Condition="'$(RequiresCoveSource)' == 'true' AND '$(CoveSourceMode)' != 'source'">
    <_CoveSourceMissing>true</_CoveSourceMissing>
  </PropertyGroup>

  <!--
    dotnet test resolves a test module's executable directly and dotnet publish copies an output
    directory, so neither goes through the Build target the import below overrides: without the three
    properties here, a project the solution build skipped stays runnable and publishable on whatever a
    previous build under another mode left behind.

    They are gated on $(_CoveSourceMissing) rather than on $(_CoveSolutionBuildSkip) because dotnet
    test enumerates test modules in an evaluation that carries no $(SolutionPath), so a property
    gated on one is never seen there. The import keeps that scoping, so a direct build still reaches
    this project's own checkout refusal.
  -->
  <PropertyGroup Condition="'$(_CoveSourceMissing)' == 'true'">
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_CoveSourceMissing)' == 'true' AND '$(SolutionPath)' != '*Undefined*' AND '$(SolutionPath)' != ''">
    <_CoveSolutionBuildSkip>true</_CoveSolutionBuildSkip>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)SkipWithoutCoveSource.targets"
          Condition="'$(_CoveSolutionBuildSkip)' == 'true'" />

</Project>
