{
  "$schema": "https://unpkg.com/knip@6.29.0/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,cjs}"],
      "project": ["scripts/**/*.{mjs,cjs}"]
    },
    "extensions/*/src/*.Ui": {
      "vite": false,
      "entry": ["src/index.ts", "src/**/*Logic.ts", "src/contracts.ts", "src/settings/options.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@vitejs/plugin-react", "@cove/runtime"]
    },
    "shared/cove-extensions-ui": {
      "entry": ["vite/createExtensionViteConfig.ts"],
      "project": ["src/**/*.{ts,tsx}", "vite/**/*.ts"],
      "ignoreDependencies": [
        "react",
        "@cove/extension-sdk",
        "lucide-react",
        "vite",
        "vitest",
        "@cove/runtime"
      ]
    },
    "tests/e2e": {
      "entry": ["**/*.spec.mjs", "lib/**/*.mjs"],
      "project": ["**/*.mjs"]
    },
    "extensions/*/e2e": {
      "entry": ["tests/**/*.spec.mjs", "lib/**/*.mjs"],
      "project": ["**/*.mjs"],
      "ignoreDependencies": ["@playwright/test"]
    }
  }
}
