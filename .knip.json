{
  "$schema": "https://unpkg.com/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,cjs}"],
      "project": ["scripts/**/*.{mjs,cjs}"]
    },
    "extensions/Renamer/src/Renamer.Ui": {
      "vite": false,
      "entry": ["src/index.ts", "src/**/*Logic.ts", "src/contracts.ts", "src/settings/options.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@vitejs/plugin-react"]
    },
    "shared/ui-shared": {
      "entry": ["vite/createExtensionViteConfig.ts", "scripts/*.{mjs,cjs}"],
      "project": ["src/**/*.{ts,tsx}", "vite/**/*.ts", "scripts/**/*.{mjs,cjs}"],
      "ignoreDependencies": [
        "react",
        "react-dom",
        "@cove/extension-sdk",
        "lucide-react",
        "vite",
        "vitest"
      ]
    },
    "tests/e2e": {
      "entry": ["**/*.spec.mjs", "lib/**/*.mjs"],
      "project": ["**/*.mjs"]
    },
    "extensions/Renamer/e2e": {
      "entry": ["tests/**/*.spec.mjs", "lib/**/*.mjs"],
      "project": ["**/*.mjs"]
    }
  }
}
