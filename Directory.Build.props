<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- The single declared host floor, from which the SDK package version derives. 1.1.0 is where
         the host commit that introduced the `@cove/runtime/api` runtime module first ships, measured
         against the released image — the floor follows the capability the extensions actually use, it
         is not a number picked to look current. Declaration order here is load-bearing, and nothing
         guards it: MSBuild evaluates properties top to bottom, so reversing these two lines expands
         $(CoveMinVersion) before it holds a value and every Cove package reference silently takes an
         empty version. No companion property is declared for
         Cove.Core, deliberately: it is never a PackageReference in this repo (it arrives transitively
         through Cove.Sdk), so such a value would have no consumer. -->
    <CoveMinVersion Condition="'$(CoveMinVersion)' == ''">1.1.0</CoveMinVersion>
    <CoveSdkVersion Condition="'$(CoveSdkVersion)' == ''">$(CoveMinVersion)</CoveSdkVersion>

    <!-- Local-Cove source selector precedence (highest wins):
         1. Explicit -p:UseLocalCoveSource=true|false (set before this file evaluates) — honored as-is.
         2. COVE_REPO env var pointing at a Cove checkout — opt in by configuration on any machine.
         3. The conventional ..\cove sibling checkout relative to this monorepo root — auto-detect
            convenience fallback.
         4. Published NuGet packages (UseLocalCoveSource=false) — the clean-clone default.
         Only the boolean is decided here; the local ProjectReference paths live in
         Directory.Build.targets, anchored at $(MSBuildThisFileDirectory) (the monorepo root), not a
         per-project relative literal. -->
    <UseLocalCoveSource Condition="'$(UseLocalCoveSource)' == '' and '$(COVE_REPO)' != '' and Exists('$(COVE_REPO)\src\Cove.Sdk\Cove.Sdk.csproj')">true</UseLocalCoveSource>
    <UseLocalCoveSource Condition="'$(UseLocalCoveSource)' == '' and Exists('$(MSBuildThisFileDirectory)..\cove\src\Cove.Sdk\Cove.Sdk.csproj')">true</UseLocalCoveSource>
    <UseLocalCoveSource Condition="'$(UseLocalCoveSource)' == ''">false</UseLocalCoveSource>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Code analysis: analyzers ship in the SDK; do NOT also add the NetAnalyzers NuGet package. -->
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Zero-warning policy: any analyzer/compiler warning fails the build (locally + CI). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Needed so IDE0005 (dead usings) is reported on build. CS1591 (missing XML doc) is silenced:
         we want dead-using detection, not a doc-comment mandate. Docs are earned by judgment, not
         forced — see the "Comments and doc tags" policy in CLAUDE.md. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
