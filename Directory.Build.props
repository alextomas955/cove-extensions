<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- The single declared host floor, from which the SDK package version derives. 1.1.0 is where
         the host commit that introduced the `@cove/runtime/api` runtime module first ships, measured
         against the released image — the floor follows the capability the extensions actually use, it
         is not a number picked to look current. Declaration order here is load-bearing, and nothing
         guards it: MSBuild evaluates properties top to bottom, so reversing these two lines expands
         $(CoveMinVersion) before it holds a value and every Cove package reference silently takes an
         empty version. No companion property is declared for
         Cove.Core, deliberately: it is never a PackageReference in this repo (it arrives transitively
         through Cove.Sdk), so such a value would have no consumer. -->
    <CoveMinVersion Condition="'$(CoveMinVersion)' == ''">1.1.0</CoveMinVersion>
    <CoveSdkVersion Condition="'$(CoveSdkVersion)' == ''">$(CoveMinVersion)</CoveSdkVersion>

    <!-- Which released Cove the CI safety leg compiles and runs against. Deliberately SEPARATE from
         $(CoveMinVersion) above: that one is the floor the extension advertises and
         validate-extension-repo.mjs compares extension.json's minCoveVersion to, while these name a
         moving upstream build. Editing CoveMinVersion to make a version guard pass would silently
         re-advertise a different floor to every user, so the two never share a value.
         scripts/fetch-cove-assemblies.mjs READS the two image properties from this file rather than
         taking them as arguments, which is what keeps the tag out of workflow YAML. -->
    <CoveTestImageRepository Condition="'$(CoveTestImageRepository)' == ''">ghcr.io/yourcove/cove-app</CoveTestImageRepository>
    <CoveTestImageTag Condition="'$(CoveTestImageTag)' == ''">nightly</CoveTestImageTag>
    <!-- The ASSEMBLY version stamped into the image's Cove.Data.dll, which is what
         Directory.Build.targets' version guard asserts. Never the informational version, whose
         `-dev.<build>` suffix moves on every nightly rebuild, so an equality guard on it would fail
         daily for no reason and would be switched off — which is how a gate dies. -->
    <CoveTestAssemblyVersion Condition="'$(CoveTestAssemblyVersion)' == ''">1.1.1.0</CoveTestAssemblyVersion>
  </PropertyGroup>

  <!--
    Where Cove is. ONE seam, read by this file, Directory.Build.targets and each test project, so a
    Cove location is stated in a single place instead of three files agreeing by luck.

      $(CoveRepoRoot)      env COVE_REPO         root of a Cove SOURCE checkout (holds src/Cove.Data/Cove.Data.csproj)
      $(CoveAssembliesDir) env COVE_ASSEMBLIES   directory of PUBLISHED Cove assemblies (holds Cove.Data.dll)
      $(CoveSourceMode)    env COVE_SOURCE_MODE  source | assemblies | none

    Precedence, highest first:
      1. An explicit -p:CoveSourceMode (or COVE_SOURCE_MODE) wins outright; an explicit
         -p:UseLocalCoveSource is honoured as the older spelling of the same intent.
      2. An explicitly-supplied CoveRepoRoot selects `source`. Source BEATS assemblies when both are
         supplied: a source checkout is the strictly more capable input, so the local loop keeps
         working on a machine that also has an extraction lying around.
      3. An explicitly-supplied CoveAssembliesDir selects `assemblies`.
      4. The conventional ..\cove sibling checkout selects `source` — the zero-config default, so no
         existing setup changes.
      5. Otherwise `none`: published NuGet packages, the clean-clone path.

    Explicitness is captured BEFORE any defaulting because D-06 turns on how a value ARRIVED, not on
    whether a path happens to exist: absence is a legitimate state for auto-detection and an error for
    explicit configuration. The failure arms themselves live in Directory.Build.targets, where a
    target can report and stop the build; a PropertyGroup can only compute.

    Paths are joined with Path.Combine and absolutised here, never string-concatenated with a
    separator. Combine emits the right separator on both platforms, and the absolute form is what the
    error messages print — which is the only reason Git Bash's MSYS rewriting of a POSIX COVE_REPO
    into a drive-lettered path was ever visible.
  -->
  <PropertyGroup>
    <_CoveModeWasPinned Condition="'$(CoveSourceMode)' != '' or '$(COVE_SOURCE_MODE)' != '' or '$(UseLocalCoveSource)' != ''">true</_CoveModeWasPinned>
    <_CoveLocationWasExplicit Condition="'$(CoveRepoRoot)' != '' or '$(COVE_REPO)' != '' or '$(CoveAssembliesDir)' != '' or '$(COVE_ASSEMBLIES)' != ''">true</_CoveLocationWasExplicit>

    <_CoveRepoRootInput Condition="'$(_CoveRepoRootInput)' == ''">$(CoveRepoRoot)</_CoveRepoRootInput>
    <_CoveRepoRootInput Condition="'$(_CoveRepoRootInput)' == ''">$(COVE_REPO)</_CoveRepoRootInput>
    <_CoveAssembliesDirInput Condition="'$(_CoveAssembliesDirInput)' == ''">$(CoveAssembliesDir)</_CoveAssembliesDirInput>
    <_CoveAssembliesDirInput Condition="'$(_CoveAssembliesDirInput)' == ''">$(COVE_ASSEMBLIES)</_CoveAssembliesDirInput>
    <CoveSourceMode Condition="'$(CoveSourceMode)' == ''">$(COVE_SOURCE_MODE)</CoveSourceMode>

    <!-- Resolution lands in PRIVATE properties rather than back onto CoveRepoRoot/CoveAssembliesDir,
         because a value that arrived by -p: is an MSBuild GLOBAL property and a PropertyGroup
         assignment to one is silently discarded. Writing the absolute form back onto the public name
         therefore looks correct, changes nothing, and leaves every consumer reading the raw relative
         value — measured here, where a relative -p:CoveAssembliesDir reached the error message
         un-absolutised. Consumers read the derived *Path properties below, which are always absolute.

         Combine against the monorepo root, so a relative value means the same thing however deep the
         project being built sits and whatever directory msbuild was launched from. Combine returns an
         already-rooted second argument unchanged, so an absolute value passes through. -->
    <_CoveRepoRootFull Condition="'$(_CoveRepoRootInput)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '$(_CoveRepoRootInput)'))))</_CoveRepoRootFull>
    <_CoveAssembliesDirFull Condition="'$(_CoveAssembliesDirInput)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '$(_CoveAssembliesDirInput)'))))</_CoveAssembliesDirFull>
    <_CoveSiblingRoot>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '..', 'cove'))))</_CoveSiblingRoot>
    <_CoveSiblingDataProject>$([System.IO.Path]::Combine('$(_CoveSiblingRoot)', 'src', 'Cove.Data', 'Cove.Data.csproj'))</_CoveSiblingDataProject>

    <CoveSourceMode Condition="'$(CoveSourceMode)' == '' and '$(UseLocalCoveSource)' == 'false'">none</CoveSourceMode>
    <CoveSourceMode Condition="'$(CoveSourceMode)' == '' and '$(UseLocalCoveSource)' == 'true'">source</CoveSourceMode>
    <CoveSourceMode Condition="'$(CoveSourceMode)' == '' and '$(_CoveRepoRootFull)' != ''">source</CoveSourceMode>
    <CoveSourceMode Condition="'$(CoveSourceMode)' == '' and '$(_CoveAssembliesDirFull)' != ''">assemblies</CoveSourceMode>
    <CoveSourceMode Condition="'$(CoveSourceMode)' == '' and Exists('$(_CoveSiblingDataProject)')">source</CoveSourceMode>
    <CoveSourceMode Condition="'$(CoveSourceMode)' == ''">none</CoveSourceMode>

    <!-- Last, so the sibling can never pre-empt an explicit CoveAssembliesDir at the mode arms above,
         while `source` mode still gets a root when the caller pinned the mode and named no path. -->
    <_CoveRepoRootFull Condition="'$(_CoveRepoRootFull)' == '' and Exists('$(_CoveSiblingDataProject)')">$(_CoveSiblingRoot)</_CoveRepoRootFull>

    <!-- The resolved, ABSOLUTE locations every consumer reads, so the path math is written once. Each
         stays empty when its half of the seam carries no root, which is what lets the failure arms in
         Directory.Build.targets name an empty location rather than a plausible-looking wrong one. -->
    <CoveRepoRootResolved>$(_CoveRepoRootFull)</CoveRepoRootResolved>
    <CoveAssembliesDirResolved>$(_CoveAssembliesDirFull)</CoveAssembliesDirResolved>
    <CoveDataProjectPath Condition="'$(_CoveRepoRootFull)' != ''">$([System.IO.Path]::Combine('$(_CoveRepoRootFull)', 'src', 'Cove.Data', 'Cove.Data.csproj'))</CoveDataProjectPath>
    <CoveCoreProjectPath Condition="'$(_CoveRepoRootFull)' != ''">$([System.IO.Path]::Combine('$(_CoveRepoRootFull)', 'src', 'Cove.Core', 'Cove.Core.csproj'))</CoveCoreProjectPath>
    <CoveSdkProjectPath Condition="'$(_CoveRepoRootFull)' != ''">$([System.IO.Path]::Combine('$(_CoveRepoRootFull)', 'src', 'Cove.Sdk', 'Cove.Sdk.csproj'))</CoveSdkProjectPath>
    <CoveSdkTargetsPath Condition="'$(_CoveRepoRootFull)' != ''">$([System.IO.Path]::Combine('$(_CoveRepoRootFull)', 'src', 'Cove.Sdk', 'buildTransitive', 'Cove.Sdk.targets'))</CoveSdkTargetsPath>
    <CoveDataAssemblyPath Condition="'$(_CoveAssembliesDirFull)' != ''">$([System.IO.Path]::Combine('$(_CoveAssembliesDirFull)', 'Cove.Data.dll'))</CoveDataAssemblyPath>
    <CoveCoreAssemblyPath Condition="'$(_CoveAssembliesDirFull)' != ''">$([System.IO.Path]::Combine('$(_CoveAssembliesDirFull)', 'Cove.Core.dll'))</CoveCoreAssemblyPath>

    <!-- Retained as the derived boolean the wiring below and the Cove.Sdk selection still read. It is
         now an OUTPUT of the mode rather than the thing that decides it. -->
    <UseLocalCoveSource Condition="'$(CoveSourceMode)' == 'source'">true</UseLocalCoveSource>
    <UseLocalCoveSource Condition="'$(CoveSourceMode)' != 'source'">false</UseLocalCoveSource>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Code analysis: analyzers ship in the SDK; do NOT also add the NetAnalyzers NuGet package. -->
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Zero-warning policy: any analyzer/compiler warning fails the build (locally + CI). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Needed so IDE0005 (dead usings) is reported on build. CS1591 (missing XML doc) is silenced:
         we want dead-using detection, not a doc-comment mandate. Docs are earned by judgment, not
         forced — see the "Comments and doc tags" policy in CLAUDE.md. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
