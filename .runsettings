<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared VSTest run settings for every test project in this repo, wired in once by
  Directory.Build.props so a second extension's test project inherits it without an edit.
-->
<RunSettings>
  <RunConfiguration>
    <!--
      A run that executed NO test exits non-zero instead of reporting success. This is the whole of
      "prove the suite ran": if a test assembly ends up empty, or a filter matches nothing, the run
      fails rather than passing green having asserted nothing.

      It replaces a pair of hand-maintained minimum-test-count floors in extensions/catalog.json. Those
      compared each leg's total against a number a human had to raise whenever tests were added, so the
      number silently fell behind the suite and the gate weakened while still printing green — twice
      (WINDOWS #51, then 19/22 tests of slack by phase 28). The defect they were built for, a directory
      wildcard dropping files out of a leg unnoticed, is closed at its source: the test project lists
      every cove-requiring file in an explicit per-file Compile Remove, so a file can only leave a leg
      by a reviewable edit. An empty extraction is likewise refused by AssertCoveLocation plus the
      extraction staleness guard, not by counting tests afterwards.
    -->
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
</RunSettings>
