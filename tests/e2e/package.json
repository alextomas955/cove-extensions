{
  "name": "@cove-extensions/e2e",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Shared end-to-end test harness for Cove extensions in this monorepo.",
  "exports": {
    ".": "./lib/fixtures.mjs",
    "./harness": "./lib/harness.mjs",
    "./seed-media": "./lib/seed-media.mjs",
    "./poll": "./lib/poll.mjs",
    "./config": "./playwright.config.mjs",
    "./resolve-extension": "./lib/resolve-extension.mjs",
    "./whisparr": "./lib/whisparr-fixture.mjs",
    "./pages/videos-page": "./lib/pages/videos-page.mjs"
  },
  "scripts": {
    "pretest": "node ../../scripts/publish-extensions.mjs",
    "test": "playwright test",
    "test:smoke": "node --test --test-timeout=900000 lib/whisparr-fixture.smoke.test.mjs",
    "test:ui": "playwright test --ui",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  },
  "dependencies": {
    "testcontainers": "^12.0.4"
  }
}
