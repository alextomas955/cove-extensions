**/bin/*
**/obj/*
artifacts/
# The Microsoft Testing Platform creates this at whatever directory dotnet test was invoked from,
# and writes reports and crash dumps into it.
TestResults/
*.zip
# TypeScript build-mode cache. No tsconfig here sets `composite`/`incremental` and the packages' own
# scripts run `tsc --noEmit`, which writes nothing — but `tsc -b` by hand and some editor TS services
# do write it, and it has kept reappearing untracked. Globbed rather than named per package so a
# second extension needs no edit here.
*.tsbuildinfo
.DS_Store
.playwright-mcp/
*.playwright-mcp.yml

# JS workspace installs — the root npm install (workspaces) hoists deps here; also covers any
# nested node_modules. Node/Playwright test artifacts are additionally ignored in tests/e2e/.gitignore.
node_modules/

# Local planning / AI-assistant scaffolding — not part of the published extension.
.planning/
# Durable local keepsakes (milestone screenshots, research snapshots) — never published.
.archive/
.claude/*
!.claude/rules/
.agents/
.cursor/
.codex/
.serena/
CLAUDE.local.md

# Docusaurus build output — website/ is a standalone package (see website/package.json);
# node_modules/ is already covered by the existing root rule above.
website/build/

# Local manual-test scratch that must never be committed: screenshots dropped at the repo root,
# stray browser-snapshot dumps, and the runtime-populated E2E media dir (the E2E uses SkyHook JSON
# fixtures, not committed media). Docs images live under website/static/img and are unaffected.
/*.png
/*.jpg
/*.jpeg
tests/e2e/docker/shared-media/

# Local scratch/audit directories — never part of a release.
.bg-shell/
.gsd/
# Probe records: `tests/e2e/probes/run.mjs --out` writes one file per row here. A record is evidence
# transcribed into the ledger, not an artefact the repository keeps.
.probe-out/

# Whisparr API tree/doc dumps from fixture probing — regenerable, never committed.
/erostree.json
/v2tree.json
/wgtree.json
/wgdocs.json
