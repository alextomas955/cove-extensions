{
  "name": "@cove-extensions/monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:cs": "dotnet format CoveExtensions.slnx --severity warn --exclude ../cove/",
    "format:cs:check": "dotnet format CoveExtensions.slnx --verify-no-changes --severity warn --exclude ../cove/",
    "knip": "knip --treat-config-hints-as-errors",
    "syncpack": "syncpack lint",
    "jscpd": "jscpd . && jscpd --config .jscpd.tests.json .",
    "prepare": "lefthook install",
    "generate:wire": "node scripts/generate-wire-types.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.1.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jscpd": "5.0.14",
    "knip": "6.29.0",
    "lefthook": "2.1.10",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "syncpack": "15.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "workspaces": [
    "tests/e2e",
    "extensions/*/e2e"
  ],
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "24.11.0"
  }
}
