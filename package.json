{
  "name": "@cove-extensions/monorepo",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:cs": "dotnet format CoveExtensions.slnx --severity warn --exclude ../cove/",
    "format:cs:check": "dotnet format CoveExtensions.slnx --verify-no-changes --severity warn --exclude ../cove/",
    "generate:wire": "node scripts/generate-wire-types.mjs",
    "jscpd": "jscpd .",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "lefthook install",
    "syncpack": "syncpack lint",
    "test": "node --test scripts/*.test.mjs",
    "markdownlint": "markdownlint-cli2",
    "wire-usage": "node scripts/check-wire-usage.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:fast": "node scripts/verify-all.mjs --group fast",
    "verify:ci": "node scripts/verify-all.mjs --group fast,slow",
    "verify:e2e": "node scripts/verify-all.mjs --group container",
    "verify:gate": "node scripts/verify-all.mjs",
    "provision:ui": "node scripts/verify-all.mjs --provision uiNodeModules"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jscpd": "5.1.1",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "markdownlint-cli2": "0.23.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "syncpack": "15.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "workspaces": [
    "tests/e2e",
    "extensions/*/e2e"
  ],
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "volta": {
    "node": "24.11.0"
  }
}
