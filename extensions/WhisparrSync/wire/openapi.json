      "get": {
        "tags": [
          "WhisparrSync"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostConfigurationView"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorCode"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.whisparrsync/connection/test": {
      "post": {
        "tags": [
          "WhisparrSync"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectionTestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionTestView"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorCode"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.whisparrsync/settings": {
      "get": {
        "tags": [
          "WhisparrSync"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhisparrSyncSettingsView"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorCode"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "WhisparrSync"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhisparrSyncSettingsSaveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhisparrSyncSettingsView"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorCode"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConnectionFailureKind": {
        "enum": [
          "connected",
          "notConfigured",
          "unreachable",
          "keyRejected",
          "notTheWhisparrApi",
          "versionNotManaged"
        ]
      },
      "ConnectionTestRequest": {
        "required": [
          "address",
          "apiKey"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": [
              "null",
              "string"
            ]
          },
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ConnectionTestView": {
        "required": [
          "kind",
          "generation",
          "version",
          "branch",
          "corroborated",
          "otherApplication",
          "address"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ConnectionFailureKind"
          },
          "generation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/WhisparrGeneration"
              }
            ]
          },
          "version": {
            "type": [
              "null",
              "string"
            ]
          },
          "branch": {
            "type": [
              "null",
              "string"
            ]
          },
          "corroborated": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "otherApplication": {
            "type": [
              "null",
              "string"
            ]
          },
          "address": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ErrorCode": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "max": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "HostConfigurationView": {
        "required": [
          "configurationResolved",
          "libraryRootCount"
        ],
        "type": "object",
        "properties": {
          "configurationResolved": {
            "type": "boolean"
          },
          "libraryRootCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "KeyWriteSignal": {
        "enum": [
          "keep",
          "replace",
          "clear"
        ]
      },
      "WhisparrGeneration": {
        "enum": [
          "v3",
          "v2",
          null
        ]
      },
      "WhisparrSyncGenerationSaveRequest": {
        "required": [
          "address",
          "keyWrite",
          "apiKey"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": [
              "null",
              "string"
            ]
          },
          "keyWrite": {
            "$ref": "#/components/schemas/KeyWriteSignal"
          },
          "apiKey": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "WhisparrSyncGenerationSettingsView": {
        "required": [
          "address",
          "keyIsSet",
          "recordedVersion",
          "versionVerifiedAtUtc",
          "lastReachableAtUtc"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "keyIsSet": {
            "type": "boolean"
          },
          "recordedVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "versionVerifiedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastReachableAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "WhisparrSyncSettingsSaveRequest": {
        "required": [
          "selectedGeneration",
          "v3",
          "v2"
        ],
        "type": "object",
        "properties": {
          "selectedGeneration": {
            "$ref": "#/components/schemas/WhisparrGeneration"
          },
          "v3": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/WhisparrSyncGenerationSaveRequest"
              }
            ]
          },
          "v2": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/WhisparrSyncGenerationSaveRequest"
              }
            ]
          }
        }
      },
      "WhisparrSyncSettingsView": {
        "required": [
          "selectedGeneration",
          "v3",
          "v2"
        ],
        "type": "object",
        "properties": {
          "selectedGeneration": {
            "$ref": "#/components/schemas/WhisparrGeneration"
          },
          "v3": {
            "$ref": "#/components/schemas/WhisparrSyncGenerationSettingsView"
          },
          "v2": {
            "$ref": "#/components/schemas/WhisparrSyncGenerationSettingsView"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "WhisparrSync"
    }
  ]
}