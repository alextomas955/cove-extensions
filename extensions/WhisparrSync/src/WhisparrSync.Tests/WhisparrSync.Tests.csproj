<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- An xUnit v3 test project is a self-hosting Microsoft Testing Platform executable; the
         framework refuses to build one that is not. -->
    <OutputType>Exe</OutputType>
    <!-- A test project is never a Cove plugin: neutralize the inherited dynamic-loading flag. -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <!--
      A test project is not deployed, so it must keep its full runtime closure. On the cove-absent
      path the extension's transitive Cove.Sdk PackageReference imports Cove.Sdk.targets, whose strip
      target would remove Cove.Plugins.dll from THIS project's output and leave xUnit unable to
      reflect over the assembly. The value must be NON-EMPTY: those targets re-apply their default
      denylist when the property is empty, so a sentinel matching no real assembly name is what
      disables the strip.
    -->
    <CoveHostProvidedAssemblies>;__whisparrsync_tests_no_strip__;</CoveHostProvidedAssemblies>
    <!--
      CA1716: the linked shared fake (Testing.Cove/FakePrincipalAccessor.cs, LinkBase="TestSupport\Shared")
      declares the Cove.Extensions.Shared.Testing namespace, whose "Shared" segment is a VB reserved
      keyword. It is a C#-only test type never consumed from VB, so the rule does not apply — mirror the
      suppression the Cove.Extensions.Shared(.Testing) projects already carry. It fires here because a
      linked file compiles INTO this assembly.
    -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!--
      TEST-ONLY runtime closure, not a compile dependency: the extension base class binds to EF Core
      types, so merely constructing the extension loads the assembly. The host supplies it at runtime
      and the extension therefore consumes it with the runtime assets excluded, which leaves it out of
      the test output unless it is named here.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!--
      TEST-ONLY: the credential table is exercised against a real relational provider on
      SQLite-in-memory, created by the SHIPPED migration string rather than by the entity model, so
      the fixture is wrong in the same way production would be wrong. On nuget.org, so it stays
      unconditional on both the cove-present and cove-absent paths.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!--
      TEST-ONLY: the route-table walk mounts the extension's own MapEndpoints in an in-process
      WebApplication and starts it, because route registrations reach the EndpointDataSource only when
      routing middleware is built at start. On nuget.org, so it stays unconditional on both source modes.
    -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The shared principal fake, pulled in as an ordinary Compile item rather than a ProjectReference:
      the file sits in a source-only sibling directory with no csproj, beside a second file that needs
      Cove.Data. It is named on its own so this project keeps compiling on the cove-absent leg, where
      Cove.Data does not resolve but Cove.Core (which is all this file needs) still does.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\shared\Cove.Extensions.Shared.Testing.Cove\FakePrincipalAccessor.cs"
             LinkBase="TestSupport\Shared" />
  </ItemGroup>

  <ItemGroup>
    <!-- The captured Whisparr response bodies ProbeFixtures reads. Flattened into the output root,
         beside extension.json, because that is where ProbeFixtures looks. -->
    <Content Include="TestSupport\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The wire-document base class and the host-free store fakes are both in this namespace. -->
    <Using Include="Cove.Extensions.Shared.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The extension's own code, and the shipped extension.json the fixture reads out of the test
         output directory. -->
    <ProjectReference Include="..\WhisparrSync\WhisparrSync.csproj" />
    <!-- Host-free shared test support. Unconditional: it builds against the Cove.Plugins package on
         the cove-absent path too. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\..\shared\Cove.Extensions.Shared.Testing\Cove.Extensions.Shared.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      TEST-ONLY: the host's own context lives in Cove.Data and its entities in Cove.Core. A test whose
      subject is Cove's per-principal query filters needs the real context, because the host declares
      those filters per host entity type and an extension-owned table carries none.

      Cove.Data is on no feed and the root targets deliberately do not wire it, so a project wanting the
      context has to say where Cove is for itself. Cove.Core is named beside it so the copy matching the
      checkout compiles rather than whatever the feed last published; a skew there splits the closure and
      is reported as a warning at most, which the compiler-only warnings-as-errors switch does not cover.
    -->
    <ProjectReference Include="$(CoveDataProjectPath)" Condition="'$(CoveSourceMode)' == 'source'" />
    <ProjectReference Include="$(CoveCoreProjectPath)" Condition="'$(CoveSourceMode)' == 'source'" />
  </ItemGroup>

  <!--
    The shared context factory, pulled in the same way as the principal fake above and keyed on the mode
    rather than on a path probe: what it needs is the Cove.Data types, which only `source` mode supplies.
    On the `none` leg it drops out and its consumers are Compile-Removed below.
  -->
  <ItemGroup Condition="'$(CoveSourceMode)' != 'none'">
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\shared\Cove.Extensions.Shared.Testing.Cove\CoveContextFactory.cs"
             LinkBase="TestSupport\Shared" />
  </ItemGroup>

  <!--
    Cove-absent path only. The extension consumes Cove.Plugins as a host-provided assembly that is not
    copied to consumers, so without this reference the test assembly fails at xUnit reflection time.
    In source mode the cove ProjectReference already supplies it and a second copy would split the
    closure.
  -->
  <ItemGroup Condition="'$(CoveSourceMode)' == 'none'">
    <PackageReference Include="Cove.Plugins" />
  </ItemGroup>

  <!-- COVE-ABSENT COMPILE SET: these reach the host's own context and entity types directly.
       A file that stands a MonitorHost belongs here too: that host owns a real CoveContext, so a
       route test consuming it reaches those same types without naming one itself. -->
  <ItemGroup Condition="'$(CoveSourceMode)' == 'none'">
    <Compile Remove="Import\CoveLibraryPortTests.cs" />
    <Compile Remove="Import\SystemPrincipalTests.cs" />
    <Compile Remove="Import\UpgradePathTests.cs" />
    <Compile Remove="Invariants\AbsentCapabilityTests.cs" />
    <Compile Remove="Invariants\SafetyInvariantTests.cs" />
    <Compile Remove="Monitoring\AddDefaultsProjectorTests.cs" />
    <Compile Remove="Monitoring\BulkEndpointTests.cs" />
    <Compile Remove="Monitoring\EntityFolderPortTests.cs" />
    <Compile Remove="Monitoring\EntityIdentityPortTests.cs" />
    <Compile Remove="Monitoring\EntitySceneIdentityPortTests.cs" />
    <Compile Remove="Monitoring\MonitorPathTests.cs" />
    <Compile Remove="Monitoring\NonGrabbingBodyTests.cs" />
    <Compile Remove="Monitoring\ReflectOwnedNeverTransfersTests.cs" />
    <Compile Remove="Monitoring\ReflectOwnedRouteTests.cs" />
    <Compile Remove="Monitoring\RefusalPrecedenceTests.cs" />
    <Compile Remove="Monitoring\SearchGrabbingRouteTests.cs" />
    <Compile Remove="Monitoring\SecondaryVerbTests.cs" />
    <Compile Remove="TestSupport\MonitorHost.cs" />
  </ItemGroup>
</Project>
