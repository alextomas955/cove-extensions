  "components": {
    "schemas": {
      "CapabilitiesView": {
        "required": [
          "coveVersion",
          "jobService",
          "scanService"
        ],
        "type": "object",
        "properties": {
          "coveVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "jobService": {
            "type": "boolean"
          },
          "scanService": {
            "type": "boolean"
          }
        }
      },
      "ErrorCode": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "max": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "RunEnded": {
        "required": [
          "runId",
          "reason"
        ],
        "type": "object",
        "properties": {
          "runId": {
            "type": [
              "null",
              "string"
            ]
          },
          "reason": {
            "$ref": "#/components/schemas/RunEndReason"
          }
        }
      },
      "RunEndReason": {
        "enum": [
          "completed",
          "failed",
          "cancelled",
          "interrupted",
          null
        ]
      },
      "RunOptions": {
        "type": "object",
        "properties": {
          "thumbnails": {
            "type": "boolean"
          },
          "previews": {
            "type": "boolean"
          },
          "sprites": {
            "type": "boolean"
          },
          "vrStereo": {
            "type": "boolean"
          },
          "imageThumbnails": {
            "type": "boolean"
          },
          "galleryThumbnails": {
            "type": "boolean"
          },
          "backfillFingerprints": {
            "type": "boolean"
          },
          "rescan": {
            "type": "boolean"
          },
          "createMissingEntities": {
            "type": "boolean"
          },
          "markOrganized": {
            "type": "boolean"
          }
        }
      },
      "RunStage": {
        "enum": [
          "scan",
          "fingerprints",
          "identify",
          "images"
        ]
      },
      "RunStageStarted": {
        "required": [
          "runId",
          "stage",
          "jobId"
        ],
        "type": "object",
        "properties": {
          "runId": {
            "type": [
              "null",
              "string"
            ]
          },
          "stage": {
            "$ref": "#/components/schemas/RunStage"
          },
          "jobId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RunStageState": {
        "enum": [
          "pending",
          "starting",
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled",
          "skipped",
          "indeterminate"
        ]
      },
      "RunStageView": {
        "required": [
          "stage",
          "state",
          "jobId"
        ],
        "type": "object",
        "properties": {
          "stage": {
            "$ref": "#/components/schemas/RunStage"
          },
          "state": {
            "$ref": "#/components/schemas/RunStageState"
          },
          "jobId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RunView": {
        "required": [
          "runId",
          "startedAt",
          "endedAt",
          "endedReason",
          "options",
          "stages"
        ],
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "endedReason": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RunEndReason"
              }
            ]
          },
          "options": {
            "$ref": "#/components/schemas/RunOptions"
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunStageView"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "ScanAndIdentify"
    }
  ]
}