        "required": [
          "sampleLabel",
          "oldName",
          "newName",
          "folder",
          "flags",
          "droppedFields"
        ],
        "type": "object",
        "properties": {
          "sampleLabel": {
            "type": "string"
          },
          "oldName": {
            "type": "string"
          },
          "newName": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "droppedFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PreviewSummary": {
        "required": [
          "totalCount",
          "sameVolumeCount",
          "crossVolumeCount",
          "crossVolumeBytes",
          "volumePairs",
          "confirmLevel",
          "undoable"
        ],
        "type": "object",
        "properties": {
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "sameVolumeCount": {
            "type": "integer",
            "format": "int32"
          },
          "crossVolumeCount": {
            "type": "integer",
            "format": "int32"
          },
          "crossVolumeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "volumePairs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VolumePairDelta"
            }
          },
          "confirmLevel": {
            "$ref": "#/components/schemas/ConfirmLevel"
          },
          "undoable": {
            "type": "boolean"
          }
        }
      },
