        "enum": [
          "video",
          "image",
          "audio",
          "gallery"
        ]
      },
      "RenamerOptions": {
        "type": "object",
        "properties": {
          "filenameTemplate": {
            "type": "string"
          },
          "folderTemplate": {
            "type": "string"
          },
          "dateFormat": {
            "type": "string"
          },
          "durationFormat": {
            "type": "string"
          },
          "performers": {
            "$ref": "#/components/schemas/MultiValueOptions"
          },
          "tags": {
            "$ref": "#/components/schemas/MultiValueOptions"
          },
          "illegalReplacement": {
            "type": "string"
          },
          "spaceReplacement": {
            "type": "string"
          },
          "case": {
            "$ref": "#/components/schemas/CaseTransform"
          },
          "removeCharacters": {
            "type": "string"
          },
          "filenameAsTitle": {
            "type": "boolean"
          },
          "removeEmptyFolder": {
            "type": "boolean"
          },
          "asciiTransliterate": {
            "type": "boolean"
          },
          "normalizePunctuation": {
            "type": "boolean"
          },
          "filenameMax": {
            "type": "integer",
            "format": "int32"
          },
          "fullPathMax": {
            "type": "integer",
            "format": "int32"
          },
          "dropOrder": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedRoots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "associatedExtensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "onlyOrganized": {
            "type": "boolean"
          },
          "requiredFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duplicateSuffixFormat": {
            "type": "string"
          },
          "autoRenamerOnUpdate": {
            "type": "boolean"
          },
          "squeezeStudioNames": {
            "type": "boolean"
          },
          "fieldReplacers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldReplaceRule"
            }
          },
          "stripLeadingArticles": {
            "type": "boolean"
          },
          "articles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preventTitlePerformer": {
            "type": "boolean"
          },
          "preventConsecutiveSegments": {
            "type": "boolean"
          },
          "studioDestinations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "tagDestinations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "pathDestinations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PathDestinationRule"
            }
          },
          "excludeTagIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "excludeStudioIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "excludePaths": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExcludeRule"
            }
          },
          "defaultDestination": {
            "type": "string"
          },
          "unorganizedDestination": {
            "type": "string"
          },
          "enableDefaultRelocate": {
            "type": "boolean"
          },
          "freeSpaceHeadroomBytes": {
            "type": "integer",
            "format": "int64"
          },
          "crossVolumeConcurrency": {
            "type": "integer",
            "format": "int32"
          },
          "sameVolumeConcurrency": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "RenamerRequest": {
        "required": [
          "entityType",
          "entityIds"
        ],
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string"
          },
          "entityIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "RenamerStatus": {
        "enum": [
          "renamer",
          "move",
          "noOp",
          "skipCollision",
          "skipGated",
          "skipExcluded",
          "skipLocked",
          "skipMissingSource",
          "skipNoSpace",
          "skipBlocked",
          "failed"
        ]
      },
      "ScanCursor": {
        "required": [
          "kind",
          "afterEntityId"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/RenamerFileKind"
          },
          "afterEntityId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ScanLibraryRequest": {
        "required": [
          "options"
        ],
        "type": "object",
        "properties": {
          "options": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ScanRow": {
        "required": [
          "kind",
          "entityId",
          "fileId",
          "oldFullPath",
          "newFullPath",
          "status",
          "reason",
          "suffixed",
          "sanitized"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/RenamerFileKind"
          },
          "entityId": {
            "type": "integer",
            "format": "int32"
          },
          "fileId": {
            "type": "integer",
            "format": "int32"
          },
          "oldFullPath": {
            "type": "string"
          },
          "newFullPath": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RenamerStatus"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "suffixed": {
            "type": "boolean"
          },
          "sanitized": {
            "type": "boolean"
          }
        }
      },
      "ScanRowsPage": {
        "required": [
          "rows",
          "next",
          "entitiesExamined",
          "budgetExhausted"
        ],
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanRow"
            }
          },
          "next": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ScanCursor"
              }
            ]
          },
          "entitiesExamined": {
            "type": "integer",
            "format": "int32"
          },
          "budgetExhausted": {
            "type": "boolean"
          }
        }
      },
      "ScanRowsRequest": {
        "required": [
          "options",
          "kind",
          "afterEntityId",
          "take",
          "query",
          "bucket"
        ],
        "type": "object",
        "properties": {
          "options": {
            "type": [
              "null",
              "string"
            ]
          },
          "kind": {
            "type": [
              "null",
              "string"
            ]
          },
          "afterEntityId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "take": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "query": {
            "type": [
              "null",
              "string"
            ]
          },
          "bucket": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SortOrder": {
        "enum": [
          "nameAsc",
          "none",
          "idAsc",
          "favoriteFirst"
        ]
      },
      "VolumePairDelta": {
        "required": [
          "from",
          "to",
          "count",
          "bytes"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "bytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Renamer"
    }
  ]
}