  "components": {
    "schemas": {
      "CaseTransform": {
        "enum": [
          "none",
          "lower",
          "title"
        ]
      },
      "ConfirmLevel": {
        "enum": [
          "light",
          "standard",
          "heavy"
        ]
      },
      "ErrorCode": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "max": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "ExcludeRule": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string"
          },
          "isRegex": {
            "type": "boolean"
          }
        }
      },
      "FieldReplaceRule": {
        "type": "object",
        "properties": {
          "targetToken": {
            "type": "string"
          },
          "find": {
            "type": "string"
          },
          "replace": {
            "type": "string"
          }
        }
      },
      "JobEnqueued": {
        "required": [
          "jobId"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          }
        }
      },
      "LastBatchSummary": {
        "required": [
          "hasBatch",
          "count",
          "writtenAtUtcTicks",
          "consumed"
