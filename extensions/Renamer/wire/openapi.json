  "components": {
    "schemas": {
      "ConfirmLevel": {
        "enum": [
          "light",
          "standard",
          "heavy"
        ]
      },
      "EntityRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ErrorCode": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "max": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          }
        }
      },
      "JobEnqueued": {
        "required": [
          "jobId"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          }
        }
      },
      "LastBatchSummary": {
        "required": [
          "hasBatch",
          "count",
          "writtenAtUtcTicks",
          "consumed"
        ],
        "type": "object",
        "properties": {
          "hasBatch": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "writtenAtUtcTicks": {
            "type": "integer",
            "format": "int64"
          },
          "consumed": {
            "type": "boolean"
          }
        }
      },
      "PreviewItemView": {
        "required": [
          "fileId",
          "oldFullPath",
          "newFullPath",
          "status",
          "newBasename",
          "targetFolderPath",
          "reason",
          "suffixed",
          "sanitized",
          "resolvedDestinationRoot",
          "matchedRule",
          "targetVolume"
        ],
        "type": "object",
        "properties": {
          "fileId": {
            "type": "integer",
            "format": "int32"
          },
          "oldFullPath": {
            "type": "string"
          },
          "newFullPath": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RenamerStatus"
          },
          "newBasename": {
            "type": "string"
          },
          "targetFolderPath": {
            "type": "string"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "suffixed": {
            "type": "boolean"
          },
          "sanitized": {
            "type": "boolean"
          },
          "resolvedDestinationRoot": {
            "type": [
              "null",
              "string"
            ]
          },
          "matchedRule": {
            "type": "string"
          },
          "targetVolume": {
            "type": "string"
          }
        }
      },
      "PreviewResponse": {
        "required": [
          "items",
          "summary"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PreviewItemView"
            }
          },
          "summary": {
            "$ref": "#/components/schemas/PreviewSummary"
          }
        }
      },
      "PreviewSampleResult": {
        "required": [
          "sampleLabel",
          "oldName",
          "newName",
          "folder",
          "flags",
          "droppedFields"
        ],
        "type": "object",
        "properties": {
          "sampleLabel": {
            "type": "string"
          },
          "oldName": {
            "type": "string"
          },
          "newName": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "droppedFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PreviewSummary": {
        "required": [
          "totalCount",
          "sameVolumeCount",
          "crossVolumeCount",
          "crossVolumeBytes",
          "volumePairs",
          "confirmLevel",
          "undoable"
        ],
        "type": "object",
        "properties": {
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "sameVolumeCount": {
            "type": "integer",
            "format": "int32"
          },
          "crossVolumeCount": {
            "type": "integer",
            "format": "int32"
          },
          "crossVolumeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "volumePairs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VolumePairDelta"
            }
          },
          "confirmLevel": {
            "$ref": "#/components/schemas/ConfirmLevel"
          },
          "undoable": {
            "type": "boolean"
          }
        }
      },
      "RenamerFileKind": {
        "enum": [
          "video",
          "image",
          "audio",
          "gallery"
        ]
      },
      "RenamerRequest": {
        "required": [
          "entityType",
          "entityIds"
        ],
        "type": "object",
        "properties": {
          "entityType": {
            "type": "string"
          },
          "entityIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "RenamerStatus": {
        "enum": [
          "renamer",
          "move",
          "noOp",
          "skipCollision",
          "skipGated",
          "skipExcluded",
          "skipLocked",
          "skipMissingSource",
          "skipNoSpace",
          "skipBlocked",
          "failed"
        ]
      },
      "ScanCursor": {
        "required": [
          "kind",
          "afterEntityId"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/RenamerFileKind"
          },
          "afterEntityId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ScanLibraryRequest": {
        "required": [
          "options"
        ],
        "type": "object",
        "properties": {
          "options": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ScanRow": {
        "required": [
          "kind",
          "entityId",
          "fileId",
          "oldFullPath",
          "newFullPath",
          "status",
          "reason",
          "suffixed",
          "sanitized"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/RenamerFileKind"
          },
          "entityId": {
            "type": "integer",
            "format": "int32"
          },
          "fileId": {
            "type": "integer",
            "format": "int32"
          },
          "oldFullPath": {
            "type": "string"
          },
          "newFullPath": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RenamerStatus"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "suffixed": {
            "type": "boolean"
          },
          "sanitized": {
            "type": "boolean"
          }
        }
      },
      "ScanRowsPage": {
        "required": [
          "rows",
          "next",
          "entitiesExamined",
          "budgetExhausted"
        ],
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanRow"
            }
          },
          "next": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ScanCursor"
              }
            ]
          },
          "entitiesExamined": {
            "type": "integer",
            "format": "int32"
          },
          "budgetExhausted": {
            "type": "boolean"
          }
        }
      },
      "ScanRowsRequest": {
        "required": [
          "options",
          "kind",
          "afterEntityId",
          "take",
          "query",
          "bucket"
        ],
        "type": "object",
        "properties": {
          "options": {
            "type": [
              "null",
              "string"
            ]
          },
          "kind": {
            "type": [
              "null",
              "string"
            ]
          },
          "afterEntityId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "take": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "query": {
            "type": [
              "null",
              "string"
            ]
          },
          "bucket": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ScanStatusCount": {
        "required": [
          "status",
          "count"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/RenamerStatus"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ScanSummaryView": {
        "required": [
          "totalFiles",
          "totalEntities",
          "willChange",
          "attention",
          "noChange",
          "statusCounts",
          "blastRadius",
          "volumePairsTruncated",
          "completedAtUtcTicks",
          "kinds"
        ],
        "type": "object",
        "properties": {
          "totalFiles": {
            "type": "integer",
            "format": "int32"
          },
          "totalEntities": {
            "type": "integer",
            "format": "int32"
          },
          "willChange": {
            "type": "integer",
            "format": "int32"
          },
          "attention": {
            "type": "integer",
            "format": "int32"
          },
          "noChange": {
            "type": "integer",
            "format": "int32"
          },
          "statusCounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanStatusCount"
            }
          },
          "blastRadius": {
            "$ref": "#/components/schemas/PreviewSummary"
          },
          "volumePairsTruncated": {
            "type": "boolean"
          },
          "completedAtUtcTicks": {
            "type": "integer",
            "format": "int64"
          },
          "kinds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RenamerFileKind"
            }
          }
        }
      },
      "UndoEntryError": {
        "required": [
          "fileId",
          "oldPath",
          "newPath",
          "reason"
        ],
        "type": "object",
        "properties": {
          "fileId": {
            "type": "integer",
            "format": "int32"
          },
          "oldPath": {
            "type": "string"
          },
          "newPath": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "UndoResult": {
        "required": [
          "undone",
          "failed",
          "skipped"
        ],
        "type": "object",
        "properties": {
          "undone": {
            "type": "integer",
            "format": "int32"
          },
          "failed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UndoEntryError"
            }
          },
          "skipped": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UndoEntryError"
            }
          }
        }
      },
      "VolumePairDelta": {
        "required": [
          "from",
          "to",
          "count",
          "bytes"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "bytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Renamer"
    }
  ]
}