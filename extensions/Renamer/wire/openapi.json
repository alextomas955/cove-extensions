        "type": "object",
        "properties": {
          "hasBatch": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "writtenAtUtcTicks": {
            "type": "integer",
            "format": "int64"
          },
          "consumed": {
            "type": "boolean"
          }
        }
      },
      "MultiValueOptions": {
        "type": "object",
        "properties": {
          "separator": {
            "type": "string"
          },
          "maxCount": {
            "type": "integer",
            "format": "int32"
          },
          "onOverflow": {
            "$ref": "#/components/schemas/OverflowPolicy"
          },
          "sort": {
            "$ref": "#/components/schemas/SortOrder"
          },
          "whitelistIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "blacklistIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "ignoreGenders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "genderOrder": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OverflowPolicy": {
        "enum": [
          "dropAll",
          "keepFirst"
        ]
      },
