{
  "openapi": "3.1.1",
  "info": {
    "title": "cove extension wire contract",
    "description": "The HTTP surface one Cove extension adds to its host. Every route is mounted under /api/extensions/<extension id> and is reached same-origin from the host page.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "The Cove host."
    }
  ],
  "paths": {
    "/api/extensions/com.alextomas955.renamer/preview": {
      "post": {
        "tags": [
          "Renamer"
        ],
        "summary": "Preview the rename of a named selection",
        "description": "Plans every file of the given entities against the saved settings and returns the planned move for each, plus the totals a confirmation needs. Touches no disk.",
        "operationId": "RenamerPreview",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenamerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/renamer": {
      "post": {
        "tags": [
          "Renamer"
        ],
        "summary": "Rename a named selection",
        "description": "Enqueues the rename of the given entities and returns at once with the job to poll. Each entity is authorized against the caller as the job runs, so a job may rename fewer than were asked for.",
        "operationId": "RenamerRenameSelected",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenamerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobEnqueued"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/preview-sample": {
      "post": {
        "tags": [
          "Renamer"
        ],
        "summary": "Preview sample names for unsaved settings",
        "description": "Renders the sample set against settings that have not been saved, which is what the settings page shows as the user types. An empty body, or one naming no settings, previews the defaults rather than what is stored.",
        "operationId": "RenamerPreviewSample",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreviewSampleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PreviewSampleResult"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/undo": {
      "post": {
        "tags": [
          "Renamer"
        ],
        "summary": "Undo the last rename batch",
        "description": "Moves the files of the most recent batch back to the names they had. Every arm it answers carries counts, including the one where there was nothing to undo, so a caller never has to infer what happened. A caller the permission gate refuses is the exception: that answers 403 with no counts.",
        "operationId": "RenamerUndo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UndoResult"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/last-batch": {
      "get": {
        "tags": [
          "Renamer"
        ],
        "summary": "Summarize the last rename batch",
        "description": "What an undo would act on, and whether it still can: a batch expires, and one already undone reports as consumed.",
        "operationId": "RenamerGetLastBatch",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LastBatchSummary"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/scan-library": {
      "post": {
        "tags": [
          "Renamer"
        ],
        "summary": "Scan the whole library for planned renames",
        "description": "Enqueues the scan and returns the job to poll along with the run its rows are read under.",
        "operationId": "RenamerScanLibrary",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/ScanLibraryRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanEnqueued"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/last-scan/{runId}": {
      "get": {
        "tags": [
          "Renamer"
        ],
        "summary": "Read a finished scan's totals",
        "description": "Only the most recent run's figures are kept, so a run replaced by a later scan answers 404.",
        "operationId": "RenamerGetScanResult",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanSummaryView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/scan-rows": {
      "post": {
        "tags": [
          "Renamer"
        ],
        "summary": "Read a page of a scan's planned renames",
        "description": "A POST because the cursor, the search and the settings the scan ran under travel in the body. A page carries the cursor the next one resumes from; a page without one ends the walk. A page may also stop on the server's per-request budget with the library only partly examined, which is not the same as having no more results.",
        "operationId": "RenamerGetScanRows",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/ScanRowsRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanRowsPage"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/last-library-rename/{runId}": {
      "get": {
        "tags": [
          "Renamer"
        ],
        "summary": "Read a finished library rename's counts",
        "description": "Only the most recent run's counts are kept, so a run replaced by a later rename answers 404.",
        "operationId": "RenamerGetLibraryRenameResult",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryRenameSummaryView"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/renamer-library": {
      "post": {
        "tags": [
          "Renamer"
        ],
        "summary": "Rename the whole library",
        "description": "Enqueues the rename of every entity the caller may write and returns the job to poll.",
        "operationId": "RenamerRenameLibrary",
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryRenameEnqueued"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/library-paths": {
      "get": {
        "tags": [
          "Renamer"
        ],
        "summary": "List the library paths Cove is configured with",
        "description": "The roots a destination rule may send files to. Host configuration, not library data.",
        "operationId": "RenamerGetLibraryPaths",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LibraryPathsView"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/job-status/{jobId}": {
      "get": {
        "tags": [
          "Renamer"
        ],
        "summary": "Read the status of a job this extension started",
        "description": "Scoped to the caller who started it. The extension answers this itself because the host's own job route requires unrestricted read, which a scoped account does not have.",
        "operationId": "RenamerGetJobStatus",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenamerJobStatus"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/orphaned-rules": {
      "get": {
        "tags": [
          "Renamer"
        ],
        "summary": "List routing rules whose entity no longer exists",
        "description": "Answered by the server because a browser cannot tell a deleted entity from one this viewer may not read.",
        "operationId": "RenamerGetOrphanedRules",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrphanedRulesView"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/extensions/com.alextomas955.renamer/options": {
      "get": {
        "tags": [
          "Renamer"
        ],
        "summary": "Read the saved rename settings",
        "description": "Returns every member, filling any the stored document omits with its default. An unreadable stored document answers with the defaults and says so rather than failing.",
        "operationId": "RenamerGetOptions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptionsView"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Renamer"
        ],
        "summary": "Replace the saved rename settings",
        "description": "The body replaces the whole document; a member it omits takes its default. Refused with 409 while a one-time conversion of the stored document is still pending.",
        "operationId": "RenamerSaveOptions",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenamerOptions"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CaseTransform": {
        "enum": [
          "none",
          "lower",
          "title"
        ]
      },
      "ConfirmLevel": {
        "enum": [
          "light",
          "standard",
          "heavy"
        ]
      },
      "Destination": {
        "type": "object",
        "properties": {
          "root": {
            "type": "string"
          },
          "template": {
            "type": "string"
          }
        }
      },
      "ExcludeRule": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string"
          },
          "isRegex": {
            "type": "boolean"
          }
        }
      },
      "FieldReplaceRule": {
        "type": "object",
        "properties": {
          "targetToken": {
            "type": "string"
          },
          "find": {
            "type": "string"
          },
          "replace": {
            "type": "string"
          }
        }
      },
      "JobEnqueued": {
        "required": [
          "jobId"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          }
        }
      },
      "KindOptions": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "destination": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Destination"
              }
            ]
          }
        }
      },
      "LastBatchSummary": {
        "required": [
          "hasBatch",
          "count",
          "remainingCount",
          "unrestorableCount",
          "writtenAtUtcTicks",
          "expiresAtUtcTicks",
          "consumed"
        ],
        "type": "object",
        "properties": {
          "hasBatch": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "remainingCount": {
            "type": "integer",
            "format": "int32"
          },
          "unrestorableCount": {
            "type": "integer",
            "format": "int32"
          },
          "writtenAtUtcTicks": {
            "type": "integer",
            "format": "int64"
          },
          "expiresAtUtcTicks": {
            "type": "integer",
            "format": "int64"
          },
          "consumed": {
            "type": "boolean"
          }
        }
      },
      "LibraryPathsView": {
        "required": [
          "paths"
        ],
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LibraryRenameEnqueued": {
        "required": [
          "jobId",
          "runId"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          }
        }
      },
      "LibraryRenameSummaryView": {
        "required": [
          "renamed",
          "skipped",
          "failed",
          "stoppedForSpace",
          "completedAtUtcTicks",
          "kinds"
        ],
        "type": "object",
        "properties": {
          "renamed": {
            "type": "integer",
            "format": "int32"
          },
          "skipped": {
            "type": "integer",
            "format": "int32"
          },
          "failed": {
            "type": "integer",
            "format": "int32"
          },
          "stoppedForSpace": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RenamerFileKind"
            }
          },
          "completedAtUtcTicks": {
            "type": "integer",
            "format": "int64"
          },
          "kinds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RenamerFileKind"
            }
          }
        }
      },
      "MultiValueOptions": {
        "type": "object",
        "properties": {
          "separator": {
            "type": "string"
          },
          "maxCount": {
            "type": "integer",
            "format": "int32"
          },
          "onOverflow": {
            "$ref": "#/components/schemas/OverflowPolicy"
          },
          "sort": {
            "$ref": "#/components/schemas/SortOrder"
          },
          "whitelistIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "blacklistIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "ignoreGenders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "genderOrder": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OptionsView": {
        "required": [
          "options",
          "pendingNameMigration",
          "pendingDestinationMigration",
          "unreadable"
        ],
        "type": "object",
        "properties": {
          "options": {
            "$ref": "#/components/schemas/RenamerOptions"
          },
          "pendingNameMigration": {
            "type": "boolean"
          },
          "pendingDestinationMigration": {
            "type": "boolean"
          },
          "unreadable": {
            "type": "boolean"
          }
        }
      },
      "OrphanedRulesView": {
        "required": [
          "studios",
          "tags"
        ],
        "type": "object",
        "properties": {
          "studios": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "OverflowPolicy": {
        "enum": [
          "dropAll",
          "keepFirst"
        ]
      },
      "PathDestinationRule": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string"
          },
          "dest": {
            "$ref": "#/components/schemas/Destination"
          },
          "isRegex": {
            "type": "boolean"
          }
        }
      },
      "PreviewItemView": {
        "required": [
          "fileId",
          "oldFullPath",
          "newFullPath",
          "status",
          "newBasename",
          "targetFolderPath",
          "reason",
          "suffixed",
          "sanitized",
          "inFlightPathOverflow",
          "resolvedDestinationRoot",
          "matchedRule",
          "targetVolume"
        ],
        "type": "object",
        "properties": {
          "fileId": {
            "type": "integer",
            "format": "int32"
          },
          "oldFullPath": {
            "type": "string"
          },
          "newFullPath": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RenamerStatus"
          },
          "newBasename": {
            "type": "string"
          },
          "targetFolderPath": {
            "type": "string"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "suffixed": {
            "type": "boolean"
          },
          "sanitized": {
            "type": "boolean"
          },
          "inFlightPathOverflow": {
            "type": "boolean"
          },
          "resolvedDestinationRoot": {
            "type": [
              "null",
              "string"
            ]
          },
          "matchedRule": {
            "type": "string"
          },
          "targetVolume": {
            "type": "string"
          }
        }
      },
      "PreviewResponse": {
