          "newBasename": {
            "type": "string"
          },
          "targetFolderPath": {
            "type": "string"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "suffixed": {
            "type": "boolean"
          },
          "sanitized": {
            "type": "boolean"
          },
          "resolvedDestinationRoot": {
            "type": [
              "null",
              "string"
            ]
          },
          "matchedRule": {
            "type": "string"
          },
          "targetVolume": {
            "type": "string"
          }
        }
      },
