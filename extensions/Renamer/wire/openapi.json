        "required": [
          "fileId",
          "oldFullPath",
          "newFullPath",
          "status",
          "newBasename",
          "targetFolderPath",
          "reason",
          "suffixed",
          "sanitized",
          "resolvedDestinationRoot",
          "matchedRule",
          "targetVolume"
