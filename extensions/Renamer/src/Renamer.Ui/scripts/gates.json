      "test": "scripts/studio-map.test.mjs",
      "envVar": "STUDIO_MAP_MODULE",
      "tmpPrefix": "rename-studio-map-"
    },
    {
      "name": "dry-run-logic",
      "modules": ["src/settings/dry-run/dryRunLogic.ts"],
