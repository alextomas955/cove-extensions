{
  "name": "@cove-extensions/renamer-ui",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "RenameSettingsPanel — the Cove Renamer extension's settings + live-preview frontend (Vite library bundle → index.mjs).",
  "license": "AGPL-3.0",
  "scripts": {
    "generate:wire": "node ../../../../scripts/generate-wire-types.mjs --extension com.alextomas955.renamer",
    "build": "vite build",
    "typecheck": "npm run generate:wire && tsc --noEmit",
    "check-classes": "node ../../../../shared/ui-shared/scripts/check-classes.cjs --allow \"shadow-[0_12px_30px_-20px_rgba(0,0,0,0.7)]\"",
    "test": "npm run generate:wire && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run format:check && npm run check-classes && npm run check-host-imports && npm run test",
    "check-host-imports": "node ../../../../scripts/check-host-imports.mjs"
  },
  "dependencies": {
    "@cove/extension-sdk": "file:vendor/cove-extension-sdk-0.1.0.tgz",
    "@tanstack/react-virtual": "3.14.10"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.1.1",
    "lucide-react": "1.28.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  },
  "volta": {
    "node": "24.11.0"
  }
}
