{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@cove-extensions/ui-shared": ["../../../../shared/ui-shared/src/index.ts"],
      "@cove-extensions/ui-shared/extensionRequest": [
        "../../../../shared/ui-shared/src/extensionRequest.ts"
      ],
      "@cove-extensions/ui-shared/testing": ["../../../../shared/ui-shared/src/testing.ts"],
      "@cove/runtime/components": ["../../../../.host-types/components/extension-shared.d.ts"],
      "@cove/runtime/api": ["../../../../.host-types/extensions/extension-api.d.ts"],
      // Every other declaration the emit produced, by its path in the Cove tree, so a host contract
      // is read from Cove rather than transcribed. Types only: unlike the two above, the host
      // serves no module behind these, so a value import resolves to nothing at build time.
      "@cove/host/*": ["../../../../.host-types/*"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"],
      "lucide-react": ["./node_modules/lucide-react"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"],
      "vite": ["./node_modules/vite/dist/node/index.d.ts"],
      "vitest": ["./node_modules/vitest"],
      "@vitejs/plugin-react": ["./node_modules/@vitejs/plugin-react/dist/index.d.ts"]
    }
  },
  // The shared package's own suite is type-checked from here for the same reason it RUNS from here
  // (see vite.config.ts): that package is consumed as raw source through an alias, so it has no
  // node_modules and no react/vitest/node types of its own to check against. Its src/ arrives in this
  // program anyway, pulled in transitively by the barrel alias above - but its test files are
  // imported by nothing, so without this entry they are the only UI tests tsc never sees.
  "include": [
    "src",
    "vite.config.ts",
    "../../../../shared/ui-shared/src/**/*.test.ts",
    "../../../../shared/ui-shared/src/**/*.test.tsx"
  ]
}
