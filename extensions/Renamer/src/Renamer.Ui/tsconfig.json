{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@cove-extensions/ui-shared": ["../../../../shared/cove-extensions-ui/src/index.ts"],
      "@cove-extensions/ui-shared/postAction": [
        "../../../../shared/cove-extensions-ui/src/postAction.ts"
      ],
      "@cove-extensions/ui-shared/extensionRequest": [
        "../../../../shared/cove-extensions-ui/src/extensionRequest.ts"
      ],
      "@cove-extensions/ui-shared/extensionStore": [
        "../../../../shared/cove-extensions-ui/src/extensionStore.ts"
      ],
      "@cove/extension-sdk": ["./node_modules/@cove/extension-sdk"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/client": ["./node_modules/@types/react-dom/client"],
      "lucide-react": ["./node_modules/lucide-react"],
      "vite": ["./node_modules/vite/dist/node/index.d.ts"],
      "@vitejs/plugin-react": ["./node_modules/@vitejs/plugin-react/dist/index.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
