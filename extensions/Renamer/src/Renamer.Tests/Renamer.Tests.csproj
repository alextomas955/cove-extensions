<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- inherits net10.0 / nullable / implicitusings from Directory.Build.props -->
    <!-- a test project is never a Cove plugin: neutralize the inherited dynamic-loading flag -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <!--
      A test project is NOT a deployed plugin: it must RUN, so it needs its full runtime closure
      copied local (EF providers, and — on the cove-ABSENT CI path — the Cove.Plugins NuGet assembly
      that FakeStore/FakeJobProgress reference). On that path Renamer.csproj's transitive Cove.Sdk
      PackageReference imports Cove.Sdk.targets, whose CoveStripHostProvidedCopyLocal target would
      strip Cove.Plugins.dll (et al.) from THIS project's output too — making xUnit fail to reflect
      over the assembly at runtime ("Could not load file or assembly 'Cove.Plugins'"). Empty the
      host-provided denylist here so nothing is stripped from the test output. No effect on the LOCAL
      path (cove present → tests reference cove via ProjectReference, the strip targets aren't imported).
      NOTE: the value must be NON-EMPTY — Cove.Sdk.targets re-applies its full default denylist when the
      property is empty (Condition="'$(CoveHostProvidedAssemblies)' == ''"). A sentinel that matches no
      real assembly name disables the strip without re-triggering the default.
    -->
    <CoveHostProvidedAssemblies>;__renamer_tests_no_strip__;</CoveHostProvidedAssemblies>
    <!--
      NU1903: a known-vuln transitive native lib (SQLitePCLRaw.lib.e_sqlite3, pulled in by
      Microsoft.EntityFrameworkCore.Sqlite). It is a TEST-ONLY dependency for the SQLite-in-memory
      integration tier and is NEVER part of the deployed Renamer.dll payload, so it poses no risk to
      users of the extension. Suppress the audit-as-error here (test project only) so
      TreatWarningsAsErrors does not block the build.
    -->
    <!--
      CA1716: the linked shared fakes (Testing.Cove/*.cs, LinkBase="TestSupport\Shared") declare the
      Cove.Extensions.Shared.Testing namespace, whose "Shared" segment is a VB reserved keyword. These are
      C#-only test types never consumed from VB, so the rule does not apply — mirror the suppression on the
      Cove.Extensions.Shared(.Testing) projects. Fires here because linked files compile INTO this assembly.
    -->
    <NoWarn>$(NoWarn);NU1903;CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!--
      TEST-ONLY: runtime Skip.IfNot(...) with a visible reason on xUnit v2 (Assert.Skip is v3-only,
      and this project pins xunit 2.9.3). Used ONLY by the privilege-gated symlink adversarial test
      so it skips WITH a reason when symlink creation lacks Developer Mode/admin — never a silent
      early-return. Verified on nuget.org + github.com/AArnott/Xunit.SkippableFact; never bundled into
      the deployed Renamer.dll (IsPackable=false test project).
    -->
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="coverlet.collector" />
    <!--
      TEST-ONLY: the integration tier stands up a real CoveContext on SQLite-in-memory
      (constraint/transaction fidelity) and EF-InMemory (fast Path-recompute). These EF
      providers + Cove.Data/Cove.Core are referenced ONLY here; the deployed Renamer.dll
      publishes Renamer.csproj alone, so host assemblies are never bundled. No version-parity
      constraint with Cove.Data's own EF Core version — confirmed a patch-level gap between the
      two already exists and works fine, since EF Core patch releases are binary-compatible within
      a major.minor line. Dependabot may bump these freely.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!--
      TEST-ONLY, and a version PIN on an edge that already exists rather than a new dependency: Npgsql
      is restored here anyway through Cove.Core → Pgvector, at a version two majors behind the one the
      released host runs. Naming it puts the compile graph on the runtime users receive. See the
      reasoning at its Directory.Packages.props entry; the symptom without it is an MSB3277 that
      TreatWarningsAsErrors cannot catch.
    -->
    <PackageReference Include="Npgsql" />
    <!--
      TEST-ONLY: TransportSmokeTests mounts the extension's MapEndpoints in an in-process
      WebApplication/TestServer to cover the real minimal-API transport boundary. On nuget.org; the
      smoke file itself is cove-present (Compile-Removed on the bare leg with the other endpoint tests).
    -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <!-- The extension declares no metadata in code, so its identity comes from this file. RenamerFixture
         parses the SHIPPED bytes rather than a stub, which needs them next to the test assembly. -->
    <Content Include="..\Renamer\extension.json" Link="extension.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Shared test fakes that need no Cove SOURCE checkout (FakeStore/ConcurrentFakeStore,
         FakePrincipalAccessor, the OpenAPI emit base) live in the Testing project, and the one that does
         (CoveContextFactory) is linked in below — both in the Cove.Extensions.Shared.Testing namespace.
         Import it globally so consumers resolve the types without a per-file using. Always resolves: the
         namespace has at least the Testing-project types on both legs. -->
    <Using Include="Cove.Extensions.Shared.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- reference the extension's CODE; tests run pure logic. Always resolves. -->
    <ProjectReference Include="..\Renamer\Renamer.csproj" />
    <!-- host-FREE shared test fakes (FakeStore/ConcurrentFakeStore over Cove.Plugins only). UNCONDITIONAL:
         it builds against nuget Cove.Plugins on the bare CI leg too. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\..\shared\Cove.Extensions.Shared.Testing\Cove.Extensions.Shared.Testing.csproj" />
    <!--
      TEST-ONLY: CoveContext lives in Cove.Data; entities in Cove.Core. Mirrors Cove.Tests.
      Neither is on nuget.org, and both sit outside the Cove.Sdk/Cove.Plugins/Cove.Core chain the root
      Directory.Build.targets wires up, so this project says where Cove is for itself — through the
      repo-wide $(CoveSourceMode) seam rather than through a relative path literal of its own. With a
      Cove checkout (the zero-config ..\cove sibling, COVE_REPO, or -p:CoveRepoRoot) the refs resolve
      and the FULL suite compiles and runs; in `assemblies` mode they are replaced by a reference to the
      released image's Cove.Data.dll below; in `none` mode they drop out and the cove-referencing
      sources are Compile-Removed, leaving the pure-core UNIT tier. The EF Sqlite/InMemory
      PackageReferences above are on NuGet and stay unconditional on every mode.
    -->
    <ProjectReference Include="$(CoveDataProjectPath)" Condition="'$(CoveSourceMode)' == 'source'" />
    <ProjectReference Include="$(CoveCoreProjectPath)" Condition="'$(CoveSourceMode)' == 'source'" />
  </ItemGroup>

  <!--
    ASSEMBLIES MODE: Cove comes from the released ghcr.io/yourcove/cove-app image, extracted by
    scripts/fetch-cove-assemblies.mjs. This is what lets the CI leg compile and run the integration
    tier against the exact binaries the released host loads, where a source build exercises a build
    nobody runs and NuGet cannot help at all (Cove.Data is on no feed).

    Private=true because a test project must RUN: it needs its full runtime closure copied local, and
    it is never published, so nothing here can reach a release.

    The reference set is deliberately the SMALLEST that resolves cleanly, and it is chosen by
    measurement rather than by symmetry: an assembly is added only when leaving it out produces an
    MSB3277 naming a Cove assembly. Cove.Core is here because the image's Cove.Data (1.1.1.0) binds to
    the matching Cove.Core, while the NuGet Cove.Core that arrives transitively through Cove.Sdk is
    1.1.0 — a two-version skew that MSBuild reports as a WARNING, and MSBuild warnings are not covered
    by TreatWarningsAsErrors, which is compiler-only.

    THE TEST PROJECT ONLY. Applying this to Renamer.csproj is measured to break it: a raw assembly
    reference carries no NuGet dependency graph, so Cove.Plugins' Microsoft.EntityFrameworkCore.Relational
    stops being supplied and six shipping files lose DbContext. The shipping project keeps its NuGet
    Cove.Sdk PackageReference, which is also what actually ships.

    Consequence, stated rather than left implicit: in this mode the test project compiles against a
    different Cove version than the shipping project does. That is safe here precisely because the test
    project is never published — and it is the point, since the version it compiles against is the one
    users receive.
  -->
  <ItemGroup Condition="'$(CoveSourceMode)' == 'assemblies'">
    <!--
      The NuGet Cove.* assemblies reach this project transitively through Renamer.csproj's Cove.Sdk
      PackageReference, and a package asset BEATS a hand-written Reference of the same simple name — so
      without these three exclusions the image references below are silently dropped and the NuGet
      assemblies are what compile and run. Measured, and worth stating because the failure is invisible
      at build time: image Cove.Data 1.1.1.0 bound to NuGet Cove.Core 1.1.0.0 produced 198
      `TypeLoadException: Could not load type 'Cove.Core.Entities.Auth.ExternalIdentityLink'` at run
      time while the build reported ZERO warnings — not even an MSB3277 — about the split closure.

      ExcludeAssets="all" rather than a version bump because there is no matching NuGet version to bump
      to: nuget.org carries these three at 1.1.0 only, which is exactly why the image is the route.
    -->
    <PackageReference Include="Cove.Core" ExcludeAssets="all" />
    <PackageReference Include="Cove.Plugins" ExcludeAssets="all" />
    <PackageReference Include="Cove.Sdk" ExcludeAssets="all" />

    <Reference Include="Cove.Data">
      <HintPath>$(CoveDataAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Cove.Core">
      <HintPath>$(CoveCoreAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Cove.Plugins">
      <HintPath>$([System.IO.Path]::Combine('$(CoveAssembliesDirResolved)', 'Cove.Plugins.dll'))</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Cove.Sdk">
      <HintPath>$([System.IO.Path]::Combine('$(CoveAssembliesDirResolved)', 'Cove.Sdk.dll'))</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!--
    COVE-DEPENDENT shared test fakes: CoveContextFactory, which needs Cove.Data. They live in a
    source-only sibling dir with NO csproj and are pulled in as ordinary per-project Compile
    items — NOT a conditional ProjectReference (IDEs don't fully respect reference conditions; msbuild#5410).
    Keyed on the mode having a Cove at all rather than on a source checkout specifically: what these
    files need is the Cove.Data TYPES, which `assemblies` mode supplies from the image just as `source`
    mode supplies them from a checkout. On the `none` leg the condition is false, the files simply drop
    out, and their consumers are already Compile-Removed below — the pure-core tier compiles.
  -->
  <ItemGroup Condition="'$(CoveSourceMode)' != 'none'">
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\shared\Cove.Extensions.Shared.Testing.Cove\*.cs"
             LinkBase="TestSupport\Shared" />
  </ItemGroup>

  <!--
    NON-SOURCE RUNTIME DEP: without a cove SOURCE checkout the cove ProjectReferences above drop out,
    so Cove.Plugins (which TestSupport/FakeJobProgress.cs references via IJobProgress, and the referenced
    Cove.Extensions.Shared.Testing's FakeStore/ConcurrentFakeStore reference via IExtensionStore) is no
    longer supplied transitively. Renamer.csproj consumes Cove.Plugins as a
    host-provided assembly (ExcludeAssets=runtime / not copied to consumers), so the test assembly would
    fail at xUnit reflection time with "Could not load file or assembly 'Cove.Plugins'". Cove.Plugins
    IS on nuget.org, so add it here with runtime copy ENABLED. `none` ONLY: assemblies mode takes
    Cove.Plugins from the image alongside the rest of the set, and adding the NuGet copy there would
    reintroduce exactly the split closure that mode exists to avoid.
  -->
  <ItemGroup Condition="'$(CoveSourceMode)' == 'none'">
    <PackageReference Include="Cove.Plugins" />
  </ItemGroup>

  <!--
    COVE-ABSENT UNIT-TIER COMPILE SET: in `none` mode — no checkout and no extraction — every source
    file that references a Cove.* type (Cove.Core entities/auth/events OR Cove.Data's CoveContext) is
    Compile-Removed so the project compiles to ONLY the pure-core unit tier. The condition names the
    MODE rather than probing for a path, which is what makes the smaller set a stated choice instead of
    an accident of what happens to be on disk: this group is INACTIVE whenever Cove is available by
    either route (all files compile, the full suite runs) and ACTIVE only on the bare leg. Folders
    Execution/ and Events/ are entirely integration, so they are removed wholesale; the rest are named
    explicitly.
      - Cove.Core-ONLY (auth/events/entities, no CoveContext): ActionDeclarationTests, Api/SettingsManifestTests,
        TestSupport/CapturingEventBus.
      - TestSupport/CoveDataExtensionScope: registers the extension via CoveContext.SetDataExtensions, which is
        Cove.Data. TestSupport is removed FILE BY FILE here, not as a folder, so a helper touching a Cove SOURCE
        type needs its own line or the bare leg fails to compile. Its sibling TestSupport/FakeRevertJournal needs
        none: it implements a port declared in Renamer's own assembly and names no Cove type.
      - INTEGRATION (real CoveContext via Cove.Data): Execution/*, Events/*,
        Jobs/RenamerBatchJobTests, Api/PreviewEndpointTests, Api/PreviewSampleEndpointTests, Api/EndpointPermissionTests,
        Api/RenamerLibraryEndpointTests, Api/ScanLibraryEndpointTests.
    The shared CoveContextFactory is NOT listed here: it lives in the source-only Testing.Cove dir and is
    pulled in by the positive Exists()-guarded Compile Include below (present only when cove is), so its
    consumers above cover the bare leg without a Compile Remove for the fake itself. FakePrincipalAccessor
    is not there either — it needs only Cove.Core.Auth, which NuGet supplies, so it sits in the
    unconditional Testing project and compiles on both legs.
    FakeJobProgress.cs is Cove.Plugins-only (available via NuGet) and stays compiled; FakeStore/ConcurrentFakeStore
    now come from the unconditional Cove.Extensions.Shared.Testing ProjectReference (Cove.Plugins-only too).
  -->
  <ItemGroup Condition="'$(CoveSourceMode)' == 'none'">
    <Compile Remove="ActionDeclarationTests.cs" />
    <!-- TransportSmokeTests boots the extension in a TestServer over a real CoveContext (Cove.Data) + CovePrincipal → drops out on a bare CI runner. -->
    <Compile Remove="Api\TransportSmokeTests.cs" />
    <Compile Remove="Api\SettingsManifestTests.cs" />
    <Compile Remove="Api\PreviewEndpointTests.cs" />
    <Compile Remove="Api\PreviewSampleEndpointTests.cs" />
    <Compile Remove="Api\EndpointPermissionTests.cs" />
    <Compile Remove="Api\EntityIdsCapTests.cs" />
    <Compile Remove="Api\PreviewRoutingTests.cs" />
    <Compile Remove="Api\RenamerLibraryEndpointTests.cs" />
    <Compile Remove="Api\ScanLibraryEndpointTests.cs" />
    <Compile Remove="Api\UndoEndpointTests.cs" />
    <Compile Remove="Jobs\RenamerBatchJobTests.cs" />
    <!-- The options conversion's L1 half drives a real CoveContext + CovePrincipal; its L0 twin
         (Options\OptionsMigrationLogicTests.cs) is pure and stays on the bare leg. -->
    <Compile Remove="Options\OptionsMigrationInitializeTests.cs" />
    <Compile Remove="Execution\**\*.cs" />
    <Compile Remove="Events\**\*.cs" />
    <Compile Remove="Concurrency\**\*.cs" />
    <Compile Remove="Preview\**\*.cs" />
    <Compile Remove="TestSupport\CapturingEventBus.cs" />
    <Compile Remove="TestSupport\CoveDataExtensionScope.cs" />
    <Compile Remove="TestSupport\JournalOnlyDatabase.cs" />
    <Compile Remove="TestSupport\Library.cs" />
    <Compile Remove="TestSupport\SharedCacheSqlite.cs" />
  </ItemGroup>
</Project>
