<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- An xUnit v3 test project is a self-hosting Microsoft Testing Platform executable; the
         framework refuses to build one that is not. -->
    <OutputType>Exe</OutputType>
    <!-- inherits net10.0 / nullable / implicitusings from Directory.Build.props -->
    <!-- a test project is never a Cove plugin: neutralize the inherited dynamic-loading flag -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <!--
      A test project is NOT a deployed plugin: it must RUN, so it needs its full runtime closure
      copied local. Renamer.csproj's transitive Cove.Sdk PackageReference imports Cove.Sdk.targets,
      whose CoveStripHostProvidedCopyLocal target would strip host-provided assemblies from THIS
      project's output too, making xUnit fail to reflect over the assembly at runtime ("Could not
      load file or assembly 'Cove.Plugins'"). The value must be NON-EMPTY: Cove.Sdk.targets re-applies
      its full default denylist when the property is empty
      (Condition="'$(CoveHostProvidedAssemblies)' == ''"). A sentinel that matches no real assembly
      name disables the strip without re-triggering the default.
    -->
    <CoveHostProvidedAssemblies>;__renamer_tests_no_strip__;</CoveHostProvidedAssemblies>
    <!--
      CA1716: the linked shared fakes (Testing.Cove/*.cs, LinkBase="TestSupport\Shared") declare the
      Cove.Extensions.Shared.Testing namespace, whose "Shared" segment is a VB reserved keyword. These are
      C#-only test types never consumed from VB, so the rule does not apply — mirror the suppression on the
      Cove.Extensions.Shared(.Testing) projects. Fires here because linked files compile INTO this assembly.
    -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!--
      TEST-ONLY: the tests that need a real context stand one up on SQLite-in-memory
      (constraint/transaction fidelity) and EF-InMemory (fast Path-recompute). These EF providers +
      Cove.Data/Cove.Core are referenced ONLY here; the deployed Renamer.dll publishes Renamer.csproj
      alone, so host assemblies are never bundled. No version-parity constraint with Cove.Data's own
      EF Core version — EF Core patch releases are binary-compatible within a major.minor line.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!--
      TEST-ONLY, and a version PIN on an edge that already exists rather than a new dependency: Npgsql
      is restored here anyway through Cove.Core → Pgvector, at a version that trails the one the host
      runs. Naming it puts the compile graph on the runtime users receive; the symptom without it is an
      MSB3277, which TreatWarningsAsErrors cannot catch because that switch is compiler-only.
    -->
    <PackageReference Include="Npgsql" />
    <!--
      TEST-ONLY: TransportSmokeTests mounts the extension's MapEndpoints in an in-process
      WebApplication/TestServer to cover the real minimal-API transport boundary.
    -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The shared test fakes (FakeStore/ConcurrentFakeStore, FakePrincipalAccessor, CoveContextFactory)
         all declare the Cove.Extensions.Shared.Testing namespace. Import it globally so consumers resolve
         the types without a per-file using. -->
    <Using Include="Cove.Extensions.Shared.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- reference the extension's CODE. -->
    <ProjectReference Include="..\Renamer\Renamer.csproj" />
    <!-- host-FREE shared test fakes (FakeStore/ConcurrentFakeStore over Cove.Plugins only). -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\..\shared\Cove.Extensions.Shared.Testing\Cove.Extensions.Shared.Testing.csproj" />
    <!--
      CoveContext lives in Cove.Data; entities in Cove.Core. Mirrors Cove.Tests.

      The two are named for different reasons. Cove.Data is on NO feed and the root
      Directory.Build.targets deliberately does not wire it, so a project wanting a real context has to
      say where Cove is for itself. Cove.Core IS on nuget.org and does reach every project transitively
      through the Cove.Sdk chain the root targets wires — it is named anyway so the Cove.Core matching
      the checkout is what compiles, rather than whatever version the feed last published. A mismatch
      there splits the closure, and MSBuild reports that skew as a warning at most, which
      TreatWarningsAsErrors does not cover because that switch is compiler-only.

      The location comes from the repo-wide $(CoveSourceMode) seam rather than a relative path literal
      of this project's own. Both are UNCONDITIONAL: this suite has no meaning without them, and the
      RequireCoveSource target below is what states that. A mode-conditional reference here is what
      used to let a test drop out of the run silently.
    -->
    <ProjectReference Include="$(CoveDataProjectPath)" />
    <ProjectReference Include="$(CoveCoreProjectPath)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      HOST-DEPENDENT shared test fakes: FakePrincipalAccessor (Cove.Core auth) + CoveContextFactory
      (Cove.Data). They live in a source-only sibling dir with NO csproj and are pulled in as ordinary
      per-project Compile items — NOT a ProjectReference (IDEs don't fully respect reference conditions;
      msbuild#5410). Promoting that directory to a real csproj would give it its own dependency on a
      Cove checkout, one level further down.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\..\shared\Cove.Extensions.Shared.Testing.Cove\*.cs"
             LinkBase="TestSupport\Shared" />
  </ItemGroup>

  <!--
    This suite needs Cove.Data types, which only a Cove source checkout supplies. Without this target
    the misconfiguration is silent where it starts: an empty $(CoveDataProjectPath) makes MSBuild drop
    the ProjectReference item and the build succeeds, and a path that does not exist reports only
    MSB9008, an MSBuild warning TreatWarningsAsErrors does not cover because that switch is
    compiler-only. Either way the first real signal is a wall of CS0234 far from its cause.
    BeforeTargets="PrepareForBuild" lands ahead of the compiler, mirroring AssertCoveLocation in the
    root Directory.Build.targets.
  -->
  <Target Name="RequireCoveSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(CoveSourceMode)' != 'source'"
           Text="$(MSBuildProjectName) requires a Cove source checkout (CoveSourceMode is '$(CoveSourceMode)'). Point COVE_REPO or -p:CoveRepoRoot at one. The extension itself builds and publishes without a checkout; its tests do not." />
  </Target>
</Project>
