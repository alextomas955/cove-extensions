<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- An xUnit v3 test project is a self-hosting Microsoft Testing Platform executable; the
         framework refuses to build one that is not. -->
    <OutputType>Exe</OutputType>
    <!-- inherits net10.0 / nullable / implicitusings from Directory.Build.props -->
    <!-- a test project is never a Cove plugin: neutralize the inherited dynamic-loading flag -->
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <!--
      A test project is NOT a deployed plugin: it must RUN, so it needs its full runtime closure
      copied local. Renamer.csproj's transitive Cove.Sdk PackageReference imports Cove.Sdk.targets,
      whose CoveStripHostProvidedCopyLocal target would strip host-provided assemblies from THIS
      project's output too, making xUnit fail to reflect over the assembly at runtime ("Could not
      load file or assembly 'Cove.Plugins'"). The value must be NON-EMPTY: Cove.Sdk.targets re-applies
      its full default denylist when the property is empty
      (Condition="'$(CoveHostProvidedAssemblies)' == ''"). A sentinel that matches no real assembly
      name disables the strip without re-triggering the default.
    -->
    <CoveHostProvidedAssemblies>;__renamer_tests_no_strip__;</CoveHostProvidedAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!--
      TEST-ONLY. Named for the RUNTIME closure, not for the compile: EF Core reaches the compile
      transitively through Cove.Core either way, but only the package path copies the assembly into
      this project's bin/. With a Cove checkout, Cove.Sdk arrives as a Private=false /
      ExcludeAssets=runtime ProjectReference, so nothing copies EF Core and the tests that dispatch
      through the extension fail at load with FileNotFoundException. The build is clean in both modes
      either way, so this edge is invisible to every compile-time check.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!--
      TEST-ONLY, and a version PIN on an edge that already exists rather than a new dependency: Npgsql
      is restored here anyway through Cove.Core → Pgvector, at a version that trails the one the host
      runs. Naming it puts the compile graph on the runtime users receive; the symptom without it is an
      MSB3277, which TreatWarningsAsErrors cannot catch because that switch is compiler-only.
    -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The shared host-free test fakes (FakeStore/ConcurrentFakeStore) declare the
         Cove.Extensions.Shared.Testing namespace. Import it globally so consumers resolve the types
         without a per-file using. -->
    <Using Include="Cove.Extensions.Shared.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- reference the extension's CODE; tests run pure logic. -->
    <ProjectReference Include="..\Renamer\Renamer.csproj" />
    <!-- host-FREE shared test fakes (FakeStore/ConcurrentFakeStore over Cove.Plugins only), which
         build against the Cove.Plugins package when no Cove checkout is present. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\..\..\shared\Cove.Extensions.Shared.Testing\Cove.Extensions.Shared.Testing.csproj" />
  </ItemGroup>
</Project>
